BIND_ADDR=0.0.0.0:3000

PUBLIC_WS_URL=wss://f8d7-147-161-160-175.ngrok-free.app/twilio/media

OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=alloy
MAX_RESPONSE_TOKENS=64
SOFT_AUDIO_LIMIT_MS=2500
HARD_AUDIO_LIMIT_MS=0
BACKLOG_LOW_WATER_MS=1500
BACKLOG_HIGH_WATER_MS=2500
RESPONSE_INSTRUCTIONS="Keep every reply extremely short. Use one sentence whenever possible. Prefer acknowledgements and direct questions over explanations. Never monologue. Avoid compound sentences, lists, and overexplaining. Yield the floor frequently."

PERSONA_INSTRUCTIONS="You are Margaret, a 71-year-old retired woman in the UK. IMPORTANT: Always speak in English only. Never speak Spanish unless the caller explicitly asks you to speak Spanish. Keep responses short, natural, and interruptible. You are polite, slightly confused, and conversational. Your goal is to keep suspicious callers talking while safely extracting information such as phone numbers, names, callback numbers, websites, crypto wallet addresses, payment instructions, company names, and scripts. Never provide real private information. Never make real payments. Ask clarifying questions naturally."

# Use "split" to run Twilio -> Deepgram STT -> OpenAI text -> Cartesia TTS.
# Keep "openai_realtime" until the provider keys below are filled in.
ORCHESTRATOR_STACK=split
OPENAI_TEXT_MODEL=gpt-4.1-nano
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_ENDPOINTING_MS=180
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3
CARTESIA_VOICE_ID=62ae83ad-4f6a-430b-af41-a9bede9286ca
CARTESIA_LANGUAGE=en

HUMANIZE_BACKGROUND_PROFILE=coffee_cafe
HUMANIZE_BACKGROUND_WAVS=assets/cafe_room.wav,assets/cups.wav
